default_platform(:android)

platform :android do
  private_lane :play_args do
    service_json = ENV.fetch('GOOGLE_PLAY_SERVICE_ACCOUNT_JSON')
    aab_path = ENV.fetch('PLAY_AAB_PATH')
    UI.user_error!("AAB not found: #{aab_path}") unless File.exist?(aab_path)

    {
      package_name: 'com.dontripit.app',
      json_key_data: service_json,
      aab: aab_path,
      track: 'internal',
      metadata_path: 'fastlane/metadata/android',
      skip_upload_images: true,
      skip_upload_screenshots: true,
    }
  end

  desc 'Validate the prepared Don’tRipIt internal release without publishing changes'
  lane :validate_play do
    upload_to_play_store(
      **play_args,
      release_status: 'draft',
      validate_only: true,
    )
  end

  desc 'Upload the prepared Don’tRipIt AAB and metadata to Internal Testing'
  lane :internal do
    upload_to_play_store(
      **play_args,
      release_status: 'completed',
    )
  end
end
