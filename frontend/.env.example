# Server-only BFF config (required)
# In Docker use http://backend:5000
INTERNAL_API_BASE_URL=http://localhost:5000
INTERNAL_API_KEY=

# Public UI config (optional)
NEXT_PUBLIC_SITE_NAME=Don’tRipIt
NEXT_PUBLIC_DEFAULT_GAME=

# Admin access credentials are intentionally omitted from this example.
# Configure strong, unique values only in the deployment secret store.
